# ==============================================================================
# Environment Variables Template (Copy to .env and populate securely)
# ==============================================================================

# System User/Group IDs
PUID=1000
PGID=1000

# Zero-Trust Overlay Interface IP (RFC 5737 Documentation Example)
OVERLAY_IP=198.51.100.10

# NAS Backup Mount Point
NAS_BACKUP_PATH=/mnt/nas_storage/monitoring_backups

# DNS High-Availability Sync Credentials (RFC 5737 Failover Node)
FAILOVER_DNS_URL=http://198.51.100.20:3000
DNS_ADMIN_USER=dns_sync_admin
DNS_ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD
